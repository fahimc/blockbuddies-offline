    "fflate": "^0.8.3",
    "localforage": "^1.10.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.14"
  },
